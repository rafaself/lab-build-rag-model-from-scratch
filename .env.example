# Copy to .env and set two different, strong passwords before starting Compose.
# .env is ignored by Git. These variables initialize a NEW database volume.
POSTGRES_DB=rag_lab
POSTGRES_PORT=55432
POSTGRES_PASSWORD=
RAG_DB_USER=rag_app
RAG_DB_PASSWORD=

# Optional on Linux when a VPN/firewall blocks the Docker bridge connection:
# COMPOSE_FILE=compose.yaml:compose.host.yaml
